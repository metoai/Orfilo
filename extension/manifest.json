{
  "manifest_version": 3,
  "name": "Orfilo - AI Deliverable Companion",
  "version": "2.0.0",
  "description": "Smart companion for Orfilo. Seamlessly captures deliverables and assets from ChatGPT, Claude, Gemini, v0, and Midjourney directly into your Orfilo workspace.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Orfilo Companion"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://docs.google.com/*",
        "*://drive.google.com/*",
        "*://v0.dev/*",
        "*://*.midjourney.com/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "*://*.vercel.app/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "notifications",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "content.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
