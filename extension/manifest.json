{
  "manifest_version": 3,
  "name": "Orfilo - AI Artifact Smart Capture",
  "version": "1.1.0",
  "description": "Smart companion for Orfilo. Automatically captures, tags, and organizes deliverables from ChatGPT, Claude, Gemini, Midjourney, and v0 into projects.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Orfilo Smart Capture"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://*.orfilo.com/*",
        "https://*.run.app/*",
        "https://*.railway.app/*",
        "https://*.vercel.app/*",
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://v0.dev/*",
        "*://*.midjourney.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "downloads",
    "notifications",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.orfilo.com/*",
    "https://*.run.app/*",
    "https://*.railway.app/*",
    "https://*.vercel.app/*",
    "*://chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://claude.ai/*",
    "*://gemini.google.com/*",
    "*://v0.dev/*",
    "*://*.midjourney.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "content.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
